# ══════════════════════════════════════════════════════════════
# AI Z — Environment Configuration
# Copy this file to .env and fill in YOUR values
# NEVER commit .env to Git — it contains secrets
#
# REQUIRED = must fill before running bootstrap
# OPTIONAL = leave blank for now, add later
# ══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
APP_NAME=AIZ
APP_ENV=production
# REQUIRED: run → openssl rand -hex 32 → paste result
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1

# ── Domain (OPTIONAL — leave blank for localhost) ─────────────
DOMAIN=localhost
DUCKDNS_TOKEN=
DUCKDNS_DOMAIN=

# ── Database (REQUIRED) ───────────────────────────────────────
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=aiz_trading
POSTGRES_USER=aiz_user
# REQUIRED: choose any strong password
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis (REQUIRED) ──────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# REQUIRED: choose any password
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── Broker (leave as 'paper' — no API key needed) ────────────
ACTIVE_BROKER=paper
TRADING_MODE=paper

# ── AngelOne (OPTIONAL — fill ONLY when going live) ──────────
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ── Zerodha (OPTIONAL — paid, fill later if needed) ──────────
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# ── Trading Parameters (safe defaults — change later) ─────────
TRADING_CAPITAL=100000
MAX_POSITIONS=5
MAX_RISK_PER_TRADE=2
STOP_LOSS_PCT=1.5
TARGET_PCT=3.0
TRAILING_STOP=true
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
WATCHLIST=RELIANCE,TCS,HDFCBANK,INFY,WIPRO,ICICIBANK,BAJFINANCE,SBIN,ITC,KOTAKBANK

# ── ML Engine (safe defaults) ────────────────────────────────
ML_MODEL=xgboost
TRAINING_LOOKBACK_YEARS=3
PREDICTION_INTERVAL=60
MIN_CONFIDENCE=65

# ── MLflow ───────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=aiz-trading

# ── Market Data ──────────────────────────────────────────────
DATA_PROVIDER=yfinance
# OPTIONAL: free key from alphavantage.co (500 calls/day)
ALPHA_VANTAGE_KEY=

# ── JWT Auth (REQUIRED) ───────────────────────────────────────
# REQUIRED: run → openssl rand -hex 32 → paste a DIFFERENT result from SECRET_KEY
JWT_SECRET=CHANGE_ME_ANOTHER_STRONG_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Admin User — your dashboard login (REQUIRED) ─────────────
ADMIN_USERNAME=admin
# REQUIRED: your dashboard login password
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=admin@localhost

# ── Notifications (OPTIONAL — add later) ─────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# ── Monitoring (REQUIRED only if enabling Grafana) ───────────
GRAFANA_ADMIN_PASSWORD=admin123
